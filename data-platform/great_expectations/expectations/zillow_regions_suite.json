{
  "expectation_suite_name": "zillow_regions_suite",
  "data_asset_type": "Dataset",
  "meta": {
    "great_expectations_version": "0.18.0"
  },
  "expectations": [
    {
      "expectation_type": "expect_table_columns_to_match_set",
      "kwargs": {
        "column_set": [
          "region_id",
          "region_id_original",
          "region_name",
          "geography_level",
          "state_code",
          "state_name",
          "city",
          "county_name",
          "metro",
          "size_rank"
        ],
        "exact_match": false
      },
      "meta": {
        "notes": "Ensure expected columns are present"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "region_id"
      },
      "meta": {
        "notes": "region_id is required"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "region_id"
      },
      "meta": {
        "notes": "region_id must be unique"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "region_name"
      },
      "meta": {
        "notes": "region_name is required"
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "geography_level"
      },
      "meta": {
        "notes": "geography_level is required"
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "geography_level",
        "value_set": [
          "National",
          "State",
          "Metro",
          "County",
          "City",
          "Zip",
          "Neighborhood"
        ]
      },
      "meta": {
        "notes": "Valid geography levels"
      }
    },
    {
      "expectation_type": "expect_column_value_lengths_to_equal",
      "kwargs": {
        "column": "state_code",
        "value": 2,
        "mostly": 0.95
      },
      "meta": {
        "notes": "State codes should be 2 characters"
      }
    },
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {
        "min_value": 1000,
        "max_value": 100000
      },
      "meta": {
        "notes": "Reasonable range for unique regions"
      }
    }
  ]
}
