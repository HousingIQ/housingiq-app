# HousingIQ Environment Configuration
# Copy this file to .env and update values as needed

# ============================================================================
# Database (shared between webapp and data-platform)
# ============================================================================
DATABASE_URL=postgresql://housingiq:housingiq@localhost:5432/housingiq
POSTGRES_USER=housingiq
POSTGRES_PASSWORD=housingiq
POSTGRES_DB=housingiq

# ============================================================================
# Webapp (Next.js)
# ============================================================================
NEXTAUTH_SECRET=dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3001

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# Data Platform
# ============================================================================
# Dagster
DAGSTER_HOME=/home/hminle/gitrepos/housingiq/housingiq-app/data-platform

# dbt
DBT_PROFILES_DIR=/home/hminle/gitrepos/housingiq/housingiq-app/data-platform/dbt

# Data directories
DATA_DIR=/home/hminle/gitrepos/housingiq/housingiq-app/data-platform/data
