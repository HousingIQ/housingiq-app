# HousingIQ Environment Configuration
# Copy to .env and update values as needed:  cp .env.example .env

# ============================================================================
# Database (shared between webapp and data-platform)
# ============================================================================
DATABASE_URL=postgresql://housingiq:housingiq@localhost:5432/housingiq

# ============================================================================
# Neon (production database sync)
# ============================================================================
NEON_DATABASE_URL=

# ============================================================================
# Auth (webapp - NextAuth.js)
# ============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=super-secret-change-me-in-production

# Google OAuth (optional - leave empty to use email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
